---
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';

export interface Props {
  id: string;
  index: number;
  total: number;
  lang: Lang;
  order: string[];
  variant?: 'hero' | 'default';
}

const { id, index, total, lang, order, variant = 'default' } = Astro.props;
const t = ui[lang];

const prevId = index > 0 ? order[index - 1] : null;
const nextId = index < total - 1 ? order[index + 1] : null;

const sectionClass = ['section', variant === 'hero' && 'section--hero']
  .filter(Boolean)
  .join(' ');
---

<section id={id} class={sectionClass}>
  <slot />
  {(prevId || nextId) && (
    <nav class="section-actions" aria-label={t.buttons.sectionNav}>
      {prevId && <a href={`#${prevId}`} class="unset">{t.buttons.prev}</a>}
      {nextId && <a href={`#${nextId}`}>{t.buttons.next}</a>}
    </nav>
  )}
</section>
