---
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';

export interface Props {
  id: string;
  lang: Lang;
  variant?: 'hero' | 'default';
  heroActions?: { id: string; label: string }[];
}

const { id, lang, variant = 'default', heroActions } = Astro.props;
const t = ui[lang];

const sectionClass = ['section', variant === 'hero' && 'section--hero']
  .filter(Boolean)
  .join(' ');
---

<section id={id} class={sectionClass}>
  <slot />
  {variant === 'hero' && heroActions && heroActions.length > 0 && (
    <nav class="section-actions" aria-label={t.buttons.sectionNav}>
      {heroActions.map((action) => (
        <a href={`#${action.id}`}>{action.label}</a>
      ))}
    </nav>
  )}
</section>
