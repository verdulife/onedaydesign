---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import IconWhatsapp from '../../components/IconWhatsapp.astro';
import IconEmail from '../../components/IconEmail.astro';
import { ui } from '../../i18n/ui';

const t = ui.ca;
---

<Base lang="ca">
  <Section
    id="presentacio"
    lang="ca"
    variant="hero"
    heroActions={[
      { id: 'projectes', label: t.buttons.viewProjects },
      { id: 'contacte', label: t.buttons.contact, secondary: true }
    ]}
  >
    <h1>
      {t.presentation.line1}
      <br />
      <strong>{t.presentation.line2}</strong>
      <br />
      {t.presentation.line3}
    </h1>
    <p>
      {t.services.line1}
      {' '}{t.services.line2}
    </p>
  </Section>

  <Section id="projectes" lang="ca">
    <h2>
      {t.projects.line1} <strong>{t.projects.line2}</strong>
      {t.projects.line3}
    </h2>
  </Section>

  <Section id="contacte" lang="ca" variant="boxed">
    <h2>
      {t.social.line1} <strong>{t.social.line2}</strong>
      {t.social.line3} {t.social.line4}
    </h2>
    <div class="section-actions">
      <a href="https://www.cosmostudio.es/" rel="noopener">
        {t.buttons.cosmo}
      </a>
    </div>
    <h2>
      {t.contact.line1} <strong>{t.contact.line2}</strong>
      {t.contact.line3} <strong>{t.contact.line4}</strong>
      {t.contact.line5}
    </h2>
    <div class="contact-links">
      <a class="contact-link" href="https://wa.me/34661100652" rel="noopener">
        <IconWhatsapp />
        {t.contact.phone}
      </a>
      <a class="contact-link" href={`mailto:${t.contact.email}`}>
        <IconEmail />
        {t.contact.email}
      </a>
    </div>
  </Section>
</Base>
