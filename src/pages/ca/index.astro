---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { ui } from '../../i18n/ui';

const t = ui.ca;
const order = ['presentacio', 'serveis', 'projectes', 'contacte'];
---

<Base lang="ca">
  <Section
    id="presentacio"
    index={0}
    total={4}
    lang="ca"
    order={order}
    variant="hero"
  >
    <h1>
      {t.presentation.line1}
      <br />
      <strong>{t.presentation.line2}</strong>
      {t.presentation.line3}
    </h1>
  </Section>

  <Section id="serveis" index={1} total={4} lang="ca" order={order}>
    <p>
      <strong>{t.services.line1}</strong> {t.services.line2}
    </p>
  </Section>

  <Section id="projectes" index={2} total={4} lang="ca" order={order}>
    <p>
      {t.projects.line1} <strong>{t.projects.line2}</strong>
      {t.projects.line3}{' '}
      <a href="https://www.instagram.com/onedaydesign.estudio" rel="noopener">
        {t.projects.line4}
      </a>
    </p>
  </Section>

  <Section id="contacte" index={3} total={4} lang="ca" order={order}>
    <p>
      {t.contact.line1}{' '}
      <a href="https://wa.me/34661100652" rel="noopener">{t.contact.line2}</a>
      {' '}{t.contact.line3}{' '}
      <a href="mailto:onedaydesign.estudio@gmail.com">{t.contact.line4}</a>
    </p>
  </Section>
</Base>
