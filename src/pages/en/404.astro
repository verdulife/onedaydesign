---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { ui } from '../../i18n/ui';

const t = ui.en;
const order = ['not-found'];
---

<Base lang="en">
  <Section
    id="not-found"
    index={0}
    total={1}
    lang="en"
    order={order}
    variant="hero"
  >
    <h1>
      404
      <br />
      <strong>{t.notFound.title}</strong>
    </h1>
    <p>
      <a href="/en/">{t.notFound.back}</a>
    </p>
  </Section>
</Base>
