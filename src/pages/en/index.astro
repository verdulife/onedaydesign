---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import IconWhatsapp from '../../components/IconWhatsapp.astro';
import IconEmail from '../../components/IconEmail.astro';
import { ui } from '../../i18n/ui';

const t = ui.en;
---

<Base lang="en">
  <Section
    id="presentation"
    lang="en"
    variant="hero"
    heroActions={[
      { id: 'projects', label: t.buttons.viewProjects },
      { id: 'contact', label: t.buttons.contact, secondary: true }
    ]}
  >
    <h1>
      {t.presentation.line1} <strong>{t.presentation.line2}</strong>
      <br />
      {t.presentation.line3}
    </h1>
    <p>
      {t.services.line1}
      {' '}{t.services.line2}
    </p>
  </Section>

  <Section id="projects" lang="en">
    <h2>
      {t.projects.line1} <strong>{t.projects.line2}</strong>
      {t.projects.line3}
    </h2>
  </Section>

  <Section id="contact" lang="en" variant="boxed">
    <h2>
      {t.contact.line1} <strong>{t.contact.line2}</strong>{' '}
      {t.contact.line3} <strong>{t.contact.line4}</strong>{' '}
      {t.contact.line5}
    </h2>
    <div class="contact-links">
      <a class="contact-link" href="https://wa.me/34661100652" rel="noopener">
        <IconWhatsapp />
        {t.contact.phone}
      </a>
      <a class="contact-link" href={`mailto:${t.contact.email}`}>
        <IconEmail />
        {t.contact.email}
      </a>
    </div>
    <p class="boxed-note">
      {t.social.line1} {t.social.line2}
      {t.social.line3} {t.social.line4}
    </p>
    <div class="section-actions">
        <a href="https://www.cosmostudio.es/" rel="noopener" class="secondary">
        {t.buttons.cosmo}
      </a>
    </div>
  </Section>
</Base>
