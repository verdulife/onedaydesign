---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import IconWhatsapp from '../../components/IconWhatsapp.astro';
import IconEmail from '../../components/IconEmail.astro';
import { ui } from '../../i18n/ui';
import { projects } from '../../data/projects';

const t = ui.en;
const loop = [...projects, ...projects];
---

<Base lang="en">
  <Section
    id="presentation"
    lang="en"
    variant="hero"
    heroActions={[
      { id: 'projects', label: t.buttons.viewProjects },
      { id: 'contact', label: t.buttons.contact, secondary: true }
    ]}
  >
    <h1>
      {t.presentation.line1} <strong>{t.presentation.line2}</strong>
      <br />
      {t.presentation.line3}
    </h1>
    <p>
      {t.services.line1}
      {' '}{t.services.line2}
    </p>
  </Section>

  <Section id="projects" lang="en" variant="fullscreen">
    <div class="projects-title">
      <h2>
        {t.projects.line1} <strong>{t.projects.line2}</strong>
        {t.projects.line3}
      </h2>
    </div>
    <div class="projects-marquee">
      <div class="marquee-track" aria-hidden="true">
        {loop.map((p) => (
          <a class="marquee-item" href={p.url} target="_blank" rel="noopener" aria-label={p.title}>
            <img src={p.image} alt="" loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    </div>
  </Section>

  <Section id="contact" lang="en" variant="boxed">
    <h2>
      {t.contact.line1} <strong>{t.contact.line2}</strong>{' '}
      {t.contact.line3} <strong>{t.contact.line4}</strong>{' '}
      {t.contact.line5}
    </h2>
    <div class="contact-links">
      <a class="contact-link secondary" href="https://wa.me/34661100652" rel="noopener">
        <IconWhatsapp />
        {t.contact.phone}
      </a>
      <a class="contact-link secondary" href={`mailto:${t.contact.email}`}>
        <IconEmail />
        {t.contact.email}
      </a>
    </div>
    <p class="boxed-note">
      {t.social.line1} {t.social.line2}
      {t.social.line3} {t.social.line4}{' '}
      <a href="https://www.cosmostudio.es/" rel="noopener">{t.social.visit}</a>.
    </p>
  </Section>
</Base>
