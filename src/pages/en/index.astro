---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import IconWhatsapp from '../../components/IconWhatsapp.astro';
import IconEmail from '../../components/IconEmail.astro';
import { ui } from '../../i18n/ui';

const t = ui.en;
const order = ['presentation', 'services', 'projects', 'contact'];
---

<Base lang="en">
  <Section
    id="presentation"
    index={0}
    total={4}
    lang="en"
    order={order}
    variant="hero"
  >
    <h1>
      {t.presentation.line1}
      <br />
      <strong>{t.presentation.line2}</strong>
      {t.presentation.line3}
    </h1>
  </Section>

  <Section id="services" index={1} total={4} lang="en" order={order}>
    <h2>
      <strong>{t.services.line1}</strong>
      {' '}{t.services.line2}
    </h2>
  </Section>

  <Section id="projects" index={2} total={4} lang="en" order={order}>
    <h2>
      {t.projects.line1} <strong>{t.projects.line2}</strong>
      {t.projects.line3}{' '}
      <a href="https://www.instagram.com/onedaydesign.estudio" rel="noopener">
        {t.projects.line4}
      </a>
    </h2>
  </Section>

  <Section id="contact" index={3} total={4} lang="en" order={order}>
    <h2>
      {t.contact.line1} <strong>{t.contact.line2}</strong>
      {' '}{t.contact.line3} <strong>{t.contact.line4}</strong>.
    </h2>
    <div class="contact-links">
      <a class="contact-link" href="https://wa.me/34661100652" rel="noopener">
        <IconWhatsapp />
        {t.contact.phone}
      </a>
      <a class="contact-link" href={`mailto:${t.contact.email}`}>
        <IconEmail />
        {t.contact.email}
      </a>
    </div>
  </Section>
</Base>
