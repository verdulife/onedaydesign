---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import IconWhatsapp from '../components/IconWhatsapp.astro';
import IconEmail from '../components/IconEmail.astro';
import { ui } from '../i18n/ui';

const t = ui.es;
---

<Base lang="es">
  <Section
    id="presentacion"
    lang="es"
    variant="hero"
    heroActions={[
      { id: 'proyectos', label: t.buttons.viewProjects },
      { id: 'contacto', label: t.buttons.contact, secondary: true }
    ]}
  >
    <h1>
      {t.presentation.line1}
      <br />
      <strong>{t.presentation.line2}</strong>
      {t.presentation.line3}
    </h1>
    <p>
      {t.services.line1}
      {' '}{t.services.line2}
    </p>
  </Section>

  <Section id="proyectos" lang="es">
    <h2>
      {t.projects.line1} <strong>{t.projects.line2}</strong>
      {t.projects.line3}{' '}
      <a href="https://www.instagram.com/onedaydesign.estudio" rel="noopener">
        {t.projects.line4}
      </a>
    </h2>
  </Section>

  <Section id="contacto" lang="es">
    <h2>
      {t.contact.line1} <strong>{t.contact.line2}</strong>
      {' '}{t.contact.line3} <strong>{t.contact.line4}</strong>.
    </h2>
    <div class="contact-links">
      <a class="contact-link" href="https://wa.me/34661100652" rel="noopener">
        <IconWhatsapp />
        {t.contact.phone}
      </a>
      <a class="contact-link" href={`mailto:${t.contact.email}`}>
        <IconEmail />
        {t.contact.email}
      </a>
    </div>
  </Section>
</Base>
