---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { ui } from '../i18n/ui';

const t = ui.es;
const order = ['no-encontrado'];
---

<Base lang="es">
  <Section
    id="no-encontrado"
    index={0}
    total={1}
    lang="es"
    order={order}
    variant="hero"
  >
    <h1>
      404
      <br />
      <strong>{t.notFound.title}</strong>
    </h1>
    <p>
      <a href="/">{t.notFound.back}</a>
    </p>
  </Section>
</Base>
