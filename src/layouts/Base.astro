---
import '../styles/global.css';
import { ui, type Lang } from '../i18n/ui';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const langPath: Record<Lang, string> = {
  es: '/',
  ca: '/ca/',
  en: '/en/'
};

const hrefLang = ['es', 'ca', 'en'] as const;
const base = Astro.site?.href ?? '/';
const siteName = 'onedaydesign';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    {hrefLang.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(langPath[l as Lang], base)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL('/', base)} />
    <link rel="canonical" href={new URL(langPath[lang], base)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/mobile.png" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={new URL(langPath[lang], base)} />
    <meta property="og:image" content={new URL('/card.jpg', base)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta
      property="og:locale"
      content={lang === 'es' ? 'es_ES' : lang === 'ca' ? 'ca_ES' : 'en_US'}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={new URL('/card.jpg', base)} />
    <meta name="theme-color" content="#0a0a0a" />
    <link
      rel="preload"
      href="/fonts/twk-everett-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        '@id': new URL('/#organization', base).href,
        name: 'onedaydesign',
        alternateName: 'onedaydesign™',
        url: new URL('/', base).href,
        logo: new URL('/logo.svg', base).href,
        description: t.meta.description,
        email: 'mailto:onedaydesign.estudio@gmail.com',
        telephone: '+34 611 100 652',
        sameAs: ['https://www.instagram.com/onedaydesign.estudio']
      })}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.buttons.skip}</a>
    <header class="site-header">
      <a href={langPath[lang]} aria-label={siteName}>
        <img src="/logo.svg" alt={siteName} />
      </a>
      <nav class="lang-switcher" aria-label="Idioma">
        {hrefLang.map((l) => (
          <a
            href={langPath[l as Lang]}
            aria-current={l === lang ? 'page' : undefined}
            lang={l}
          >
            {l.toUpperCase()}
          </a>
        ))}
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
